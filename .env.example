# StudyUp local secrets — DO NOT COMMIT.
# Copy to a local, untracked `.env` file (never into the repo) or pass
# values as build-time dart-defines, e.g.:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://xyzcompany.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi... \
#     --dart-define=INVITE_HOST=invite.example.com
#
# Resolution order: dart-defines first, then the local `.env` file.
#
# The publishable/anon key is safe to embed (RLS enforces access).
# NEVER put the service-role key in the app or this file.

SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Optional. Must match AndroidManifest.xml + assetlinks.json.
# Primary host: the Vercel project domain (serves
# /.well-known/assetlinks.json from public/). Use the stable *project*
# domain, never a per-deployment URL (those change on every deploy).
# The earlier studyup-feedback-api.vercel.app host and the legacy host
# invite.studyup.app stay accepted by the manifest for old links.
INVITE_HOST=studyup-4x7z-medurinishanth78-6030s-projects.vercel.app

# Optional custom-scheme fallback (works without any hosting).
INVITE_SCHEME=studyup

# Public feedback endpoint base URL (no secrets — Resend keys stay in Vercel).
# Use the deployed Vercel project URL, e.g. https://studyup-xyz.vercel.app
# The app posts to <FEEDBACK_API_URL>/api/feedback.
# Resolution order: --dart-define=FEEDBACK_API_URL=... first, then this file.
# Optional: when unset, the app uses the hosted endpoint
#   https://studyup-4x7z-medurinishanth78-6030s-projects.vercel.app/api/feedback
# automatically whenever the Supabase `send-feedback` Edge Function is
# not deployed yet (FeedbackSubmitter fallback chain).
FEEDBACK_API_URL=https://YOUR_PROJECT.vercel.app
